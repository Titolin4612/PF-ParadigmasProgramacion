@model IReadOnlyList<MVC_ProyectoFinalPOO.Services.PartidaHistorialEntry>

@{
    ViewData["Title"] = "Historial de Partidas";
}

<div class="game-container historial-page">
    <section class="historial-scroll" aria-labelledby="historial-title">
        <div class="historial-header">
            <p class="historial-kicker">Crónicas del destino</p>
            <h1 id="historial-title">Historial de Partidas</h1>
            <p class="historial-summary">
                Últimas partidas guardadas por los dioses, ordenadas desde la más reciente.
            </p>
        </div>

        @if (Model.Count == 0)
        {
            <div class="historial-empty">
                <i class="fas fa-scroll"></i>
                <p>No hay partidas guardadas todavía.</p>
            </div>
        }
        else
        {
            <div class="historial-table-wrap">
                <table class="historial-table">
                    <thead>
                        <tr>
                            <th scope="col">Fecha</th>
                            <th scope="col">Ganador</th>
                            <th scope="col">Puntos</th>
                            <th scope="col">Jugadores</th>
                            <th scope="col">Cartas jugadas</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var partida in Model)
                        {
                            <tr>
                                <td data-label="Fecha">@partida.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td data-label="Ganador">
                                    <span class="historial-winner">
                                        <i class="fas fa-crown"></i>
                                        @partida.NombreGanador
                                    </span>
                                </td>
                                <td data-label="Puntos">@partida.PuntosGanador</td>
                                <td data-label="Jugadores">@partida.CantidadJugadores</td>
                                <td data-label="Cartas jugadas">@partida.CartasJugadas</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <img src="~/images/character-male4.png" class="character male historial-character" alt="" />
    <img src="~/images/character-female4.png" class="character female historial-character" alt="" />
</div>

<style>
    html,
    body {
        overflow-x: hidden;
    }

    body {
        min-width: 0;
    }

    .historial-page {
        isolation: isolate;
        min-height: 100vh;
        height: auto;
        width: 100%;
        max-width: 100vw;
        padding: 110px 16px 48px;
        margin: 0;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .historial-scroll {
        position: relative;
        z-index: 5;
        width: min(980px, 100%);
        margin: 0 auto;
        padding: 34px;
        box-sizing: border-box;
        color: #f8edcf;
        background: linear-gradient(180deg, rgba(18, 12, 8, 0.92), rgba(42, 28, 16, 0.88));
        border: 2px solid #d4af37;
        border-radius: 12px;
        box-shadow: 0 0 28px rgba(0, 0, 0, 0.55), inset 0 0 22px rgba(212, 175, 55, 0.08);
        backdrop-filter: blur(4px);
    }

    .historial-header {
        text-align: center;
        margin-bottom: 28px;
    }

    .historial-kicker {
        margin: 0 0 8px;
        color: #d4af37;
        font-family: 'Cinzel', Georgia, serif;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .historial-header h1 {
        margin: 0;
        color: #ffe8a3;
        font-family: 'Cinzel', Georgia, serif;
        font-size: clamp(2rem, 5vw, 3.1rem);
        text-shadow: 0 0 12px rgba(212, 175, 55, 0.45);
    }

    .historial-summary {
        max-width: 620px;
        margin: 14px auto 0;
        color: #ead8ae;
        font-size: 1rem;
        line-height: 1.6;
    }

    .historial-table-wrap {
        overflow-x: auto;
        border: 1px solid rgba(212, 175, 55, 0.55);
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.28);
    }

    .historial-table {
        width: 100%;
        min-width: 720px;
        border-collapse: collapse;
        color: #f8edcf;
    }

    .historial-table th,
    .historial-table td {
        padding: 16px 18px;
        text-align: left;
        border-bottom: 1px solid rgba(212, 175, 55, 0.22);
        white-space: nowrap;
    }

    .historial-table th {
        color: #2a1f0f;
        background: linear-gradient(to right, #ffedc4, #f9d97c);
        font-family: 'Cinzel', Georgia, serif;
        font-size: 0.92rem;
        text-transform: uppercase;
    }

    .historial-table tbody tr:nth-child(even) {
        background: rgba(255, 255, 255, 0.05);
    }

    .historial-table tbody tr:hover {
        background: rgba(212, 175, 55, 0.12);
    }

    .historial-winner {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #ffdf72;
        font-weight: 700;
    }

    .historial-empty {
        display: grid;
        place-items: center;
        gap: 12px;
        min-height: 220px;
        color: #ead8ae;
        border: 1px dashed rgba(212, 175, 55, 0.55);
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.24);
    }

    .historial-empty i {
        color: #d4af37;
        font-size: 2.5rem;
    }

    .historial-empty p {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .historial-character {
        position: fixed;
        bottom: 0;
        width: auto;
        max-height: 58vh;
        opacity: 0.84;
        z-index: 2;
        --historial-character-offset: 780px;
        --historial-character-bleed: -150px;
    }

    .historial-character.male {
        left: max(var(--historial-character-bleed), calc(50vw - var(--historial-character-offset)));
        margin-left: -24px;
    }

    .historial-character.female {
        right: max(var(--historial-character-bleed), calc(50vw - var(--historial-character-offset)));
        margin-right: -24px;
    }

    @@media (max-width: 768px) {
        .historial-page {
            padding-top: 120px;
        }

        .historial-scroll {
            padding: 24px 16px;
        }

        .historial-table {
            min-width: 0;
        }

        .historial-table thead {
            display: none;
        }

        .historial-table,
        .historial-table tbody,
        .historial-table tr,
        .historial-table td {
            display: block;
            width: 100%;
        }

        .historial-table tr {
            padding: 12px 0;
            border-bottom: 1px solid rgba(212, 175, 55, 0.35);
        }

        .historial-table td {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            padding: 10px 14px;
            border-bottom: 0;
            white-space: normal;
            text-align: right;
        }

        .historial-table td::before {
            content: attr(data-label);
            color: #d4af37;
            font-family: 'Cinzel', Georgia, serif;
            font-weight: 700;
            text-align: left;
        }

        .historial-character {
            display: none;
        }
    }
</style>
